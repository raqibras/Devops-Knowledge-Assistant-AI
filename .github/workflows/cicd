name: CI/CD Pipeline

on:
  push:
    branches:
      - qa
  # Runs when a PR is merged into Prod
  pull_request:
    types: [closed]
    branches:
      - main

jobs:
  # ---------------------------------------------------------
  # 1. Build & Test — runs on every push to QA
  # ---------------------------------------------------------
  build-and-test:
    if: github.ref == 'refs/heads/QA' && github.event_name == 'push'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up environment
        run: echo "Add your language/runtime setup here (node, python, etc.)"

      - name: Install dependencies
        run: echo "npm ci / pip install -r requirements.txt / etc."

      - name: Run tests
        run: echo "npm test / pytest / etc."

  # ---------------------------------------------------------
  # 2. Deploy to QA — auto-deploy after tests pass on QA branch
  # ---------------------------------------------------------
  deploy-qa:
    needs: build-and-test
    if: github.ref == 'refs/heads/QA' && github.event_name == 'push'
    runs-on: ubuntu-latest
    environment:
      name: QA   # optional: track QA deploys as an environment too
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Deploy to QA environment
        run: echo "Add your QA deployment steps here (e.g., aws/azure/gcp CLI, kubectl, etc.)"

      - name: Notify QA team
        run: echo "Optional: Slack/Teams notification that QA deploy is ready for testing"

  # ---------------------------------------------------------
  # 3. Deploy to Prod — only runs once PR into Prod is merged,
  #    AND only after required reviewers approve the 'production'
  #    environment (configured in repo settings, see notes below)
  # ---------------------------------------------------------
  deploy-prod:
    if: github.event_name == 'pull_request' && github.event.pull_request.merged == true && github.base_ref == 'Prod'
    runs-on: ubuntu-latest
    environment:
      name: Prod   # <-- this is the gate; GitHub pauses here for approval
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          ref: Prod

      - name: Deploy to Production environment
        run: echo "Add your Prod deployment steps here"

      - name: Notify team of Prod deployment
        run: echo "Optional: Slack/Teams notification that deploy succeeded"
